{
  "name": "@vantageos/mosaic-i18n",
  "version": "0.1.1",
  "description": "FR+EN locale resources and react-i18next wiring for @vantageos/mosaic.",
  "license": "FSL-1.1-Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./locales/en.json": "./src/locales/en.json",
    "./locales/fr.json": "./src/locales/fr.json"
  },
  "files": [
    "dist",
    "src/locales",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "vantageos",
    "mosaic",
    "i18n",
    "internationalization",
    "react-i18next",
    "i18next",
    "fr",
    "en",
    "locales",
    "translations",
    "bilingual",
    "french",
    "english"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elpiarthera/vantageos-mosaic.git",
    "directory": "packages/mosaic-i18n"
  },
  "homepage": "https://vantageos.com/mosaic",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check --error-on-warnings src",
    "test": "echo 'no tests yet' && exit 0",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "i18next": "^25.0.0",
    "react-i18next": "15.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "i18next": "25.0.0",
    "react-i18next": "15.5.2",
    "tsup": "8.4.0",
    "typescript": "5.8.3"
  }
}
