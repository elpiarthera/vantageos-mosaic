    "typescript": "5.8.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "1.32.0",
      "@storybook/core": "8.6.19",
      "axios": "1.20.0",
      "brace-expansion@1": "1.1.20",
      "brace-expansion@2": "2.1.6",
      "brace-expansion@5": "5.0.11",
      "fast-uri@3": "3.1.7",
      "follow-redirects": "1.16.1",
